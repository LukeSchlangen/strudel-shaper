{
  "name": "strudel-shaper",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,proxy -c blue,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "server": "tsx server/index.ts",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "build:reference": "node eval/runner.mjs scripts/build-reference.ts",
    "eval": "node eval/runner.mjs eval/run.ts",
    "check:key": "node scripts/check-key.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.134.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@hono/node-server": "2.1.5",
    "@strudel/core": "1.2.6",
    "@strudel/mini": "1.2.6",
    "@strudel/repl": "1.3.0",
    "@strudel/tonal": "1.2.6",
    "@strudel/transpiler": "1.2.6",
    "@strudel/webaudio": "1.3.0",
    "diff": "9.0.0",
    "dotenv": "18.0.8",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "concurrently": "10.0.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
