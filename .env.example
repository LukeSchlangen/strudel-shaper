# Copy to .env (which is git-ignored) and fill in. Read only by the proxy (server/), never by the browser.
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIzaSy...

# Global upstream calls per minute, retries included (default 25).
RATE_LIMIT_PER_MIN=25
# Upstream calls per minute per client IP address (default 10).
RATE_LIMIT_PER_IP_PER_MIN=10

# max_tokens per call; clamped to 1200 (default 1024; single options capped at 400).
MAX_TOKENS=1024

# Proxy port; Vite forwards /api/* here (default 8787 in dev, 8080 in prod).
PORT=8787
