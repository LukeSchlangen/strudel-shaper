# Copy to .env (which is git-ignored) and fill in. Read only by the proxy (server/), never by the browser.
ANTHROPIC_API_KEY=sk-ant-...
# Upstream calls per minute, retries included (default 20).
RATE_LIMIT_PER_MIN=20
# max_tokens per call; clamped to 4096 (default 2048).
MAX_TOKENS=2048
# Proxy port; Vite forwards /api/* here (default 8787).
PORT=8787
